# Local development works without this file. Docker requires a private workspace password.
PCN_ACCESS_KEY=
PCN_PUBLIC_ORIGIN=http://localhost:8000
PCN_COOKIE_SECURE=false

# Owner-approved access through Neon's managed Better Auth (same branch as DATABASE_URL).
# Auth URL is public; copy it from Neon > Better Auth > Configuration.
NEON_AUTH_BASE_URL=
# This verified email is the workspace owner and receives access requests.
PCN_ACCESS_REQUEST_EMAIL=
# Optional owner-notification sender. Neon sends sign-in codes itself.
# Without a domain, use Civic <onboarding@resend.dev> and your Resend signup inbox as the owner.
RESEND_API_KEY=
PCN_EMAIL_FROM=
# When Neon is enabled, shared-password login is off. Enable only for owner recovery.
PCN_ALLOW_PASSWORD_LOGIN=false

# Neon: paste the PostgreSQL URL from its Connect dialog (including sslmode=require).
# Leave blank to keep SQLite for offline development. Never commit a real URL.
DATABASE_URL=
PCN_DB_SCHEMA=civic
# Store small uploads in the shared database; local disk remains an offline option.
PCN_EVIDENCE_STORAGE=database

# No network inference or provider costs in stub mode.
AI_PROVIDER=stub
# Change AI_PROVIDER to mubit only when ready to use your account.
MUBIT_API_KEY=
MUBIT_ROUTE=anthropic
MUBIT_MODEL=
MUBIT_BASE_URL=
MUBIT_RECORD=full
MUBIT_MAX_TOKENS=1500
MUBIT_TIMEOUT_S=60

# One council/source system per isolated workspace. These defaults are synthetic.
PCN_COUNCIL_ID=northgate-sandbox
PCN_COUNCIL_NAME=Northgate Borough
PCN_CASE_SYSTEM=generic
# Separate server-to-server secret, at least 32 characters. Never put in browser code.
PCN_INTEGRATION_KEY=
# Production AI reviews require Mubit; stub is permitted only in local development/tests.
