# Local development works without this file. Docker requires a private workspace password.
PCN_ACCESS_KEY=
PCN_PUBLIC_ORIGIN=http://localhost:8000
PCN_COOKIE_SECURE=false

# No network inference or provider costs in stub mode.
AI_PROVIDER=stub
# Change AI_PROVIDER to mubit only when ready to use your account.
MUBIT_API_KEY=
MUBIT_ROUTE=anthropic
MUBIT_MODEL=
MUBIT_BASE_URL=
MUBIT_RECORD=full
MUBIT_MAX_TOKENS=1500
MUBIT_TIMEOUT_S=60
