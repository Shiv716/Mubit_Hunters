# Legacy AI-only template. Prefer the complete root .env.example for new setups.
# backend/.env overrides root .env; both are ignored. Never commit real credentials.

# Mubit key (starts with mbt_). Local development can use the offline stub. Production requires Mubit for AI reviews.
MUBIT_API_KEY=

# openai | anthropic. Use a route/model enabled in your Mubit account.
# Consumer photo scanning requires a vision-capable model.
MUBIT_ROUTE=anthropic
# Optional: defaults to the route's model (anthropic -> claude-haiku-4-5, openai -> gpt-6-luna).
MUBIT_MODEL=
# Optional: use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=

# full | metadata | off: council recording setting; consumer AI forces metadata.
# Recording is not proof of training. Civic does not submit corrections or select adapters.
MUBIT_RECORD=full
MUBIT_MAX_TOKENS=1500
MUBIT_TIMEOUT_S=60

# Provider: mubit | stub. Production defaults to mubit and refuses stub reviews.
# AI_PROVIDER=stub
