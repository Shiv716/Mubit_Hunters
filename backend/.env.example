# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit a real key.

# Mubit key (starts with mbt_). Leave unset to run on the offline stub (no cost, not Mubit).
MUBIT_API_KEY=

# openai | anthropic. Anthropic route uses Mubit's starter credit for Claude models; no Claude Pro/API account needed.
MUBIT_ROUTE=anthropic
# Optional: defaults to the route's model (anthropic -> claude-haiku-4-5, openai -> gpt-6-luna).
MUBIT_MODEL=
# Optional: use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=

# full | metadata | off  (what Mubit records; only 'full' calls can become adapter training examples)
MUBIT_RECORD=full
MUBIT_MAX_TOKENS=500
MUBIT_TIMEOUT_S=60

# Force a provider: mubit | stub (default: mubit if MUBIT_API_KEY is set, else stub)
# AI_PROVIDER=stub
